{
  "schema_version": "1.0",
  "secrets": [
    {
      "name": "test_user_username",
      "env_key": "TEST_USER_USERNAME",
      "type": "credential",
      "sensitivity": "secret",
      "providers": [
        "runtime",
        "local",
        "environment",
        "manual"
      ],
      "persist_policy": "allowed"
    },
    {
      "name": "test_user_password",
      "env_key": "TEST_USER_PASSWORD",
      "type": "credential",
      "sensitivity": "secret",
      "providers": [
        "runtime",
        "local",
        "environment",
        "manual"
      ],
      "persist_policy": "never"
    },
    {
      "name": "api_token",
      "env_key": "API_TOKEN",
      "type": "token",
      "sensitivity": "secret",
      "providers": [
        "runtime",
        "local",
        "environment",
        "vault",
        "aws_secrets_manager",
        "github_actions",
        "kubernetes",
        "manual"
      ],
      "persist_policy": "never"
    }
  ]
}
